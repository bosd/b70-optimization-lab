From 6d8724577dabbee5fa0bbc70c4d927c6174c8d8a Mon Sep 17 00:00:00 2001
From: Codex Agent <codex-agent@users.noreply.github.com>
Date: Mon, 7 Sep 2026 13:16:04 -0400
Subject: [PATCH 2/2] [XPU] the fused QSA pre-indexer must not preempt the
 row-serial verify path

On the lossless MTP1 head the multi-row verify step takes _forward_serial_rows so that rows
sharing a compression group cannot race for one compressed slot. The fused branch was placed
ahead of it and would have taken those steps; it now runs only when the serial path does not.

Co-authored-by: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 vllm/models/qwen4_exp/amd/indexer_qsa.py | 28 ++++++++++++++----------
 1 file changed, 16 insertions(+), 12 deletions(-)

diff --git a/vllm/models/qwen4_exp/amd/indexer_qsa.py b/vllm/models/qwen4_exp/amd/indexer_qsa.py
index c2dc7471f..0a60def20 100644
--- a/vllm/models/qwen4_exp/amd/indexer_qsa.py
+++ b/vllm/models/qwen4_exp/amd/indexer_qsa.py
@@ -380,6 +380,22 @@ class QSAIndexer(nn.Module):
             return result
         raw_metadata, compressed_metadata = metadata
         num_tokens = raw_metadata.num_actual_tokens
+        q, token_k = self.project_qk(
+            hidden_states[:num_tokens], positions[..., :num_tokens]
+        )
+        if (
+            envs.VLLM_XPU_QSA_SERIAL_SPEC_INDEXER
+            and not self.skip_topk
+            and 1 < num_tokens <= _SERIAL_SPEC_INDEXER_MAX_ROWS
+            and raw_metadata.query_start_loc.numel() == 2
+        ):
+            return self._forward_serial_rows(
+                q, token_k, positions, raw_metadata, compressed_metadata, out
+            )
+        # After the row-serial branch on purpose: in a multi-row verify step rows in one
+        # compression group race for a single compressed slot, and the serial path exists
+        # to keep that exact. The fused kernel processes the rows together, so it must not
+        # preempt it.
         if self._fused_pre_indexer and not self.skip_topk:
             projected_qk, _ = self.index_qk_proj(hidden_states[:num_tokens])
             projected_q, raw_keys = projected_qk.split(
@@ -419,18 +435,6 @@ class QSAIndexer(nn.Module):
                 ),
             )
             return self._select(q, compressed_metadata, out)
-        q, token_k = self.project_qk(
-            hidden_states[:num_tokens], positions[..., :num_tokens]
-        )
-        if (
-            envs.VLLM_XPU_QSA_SERIAL_SPEC_INDEXER
-            and not self.skip_topk
-            and 1 < num_tokens <= _SERIAL_SPEC_INDEXER_MAX_ROWS
-            and raw_metadata.query_start_loc.numel() == 2
-        ):
-            return self._forward_serial_rows(
-                q, token_k, positions, raw_metadata, compressed_metadata, out
-            )
         self._update_and_compress(
             token_k,
             positions[..., :num_tokens],
